{
  "_README": "dsh-focus-mode 引擎配置。protectShells=保护终端；skipSession0=不碰服务；hostProtected=任何档案都绝不冻结的进程（DSH、工具运行时、本地模型服务、显示叠加层、远程会话）；profiles 只冻结明确列出的白名单，未列出的一律跳过。脚本内另有硬编码保护：反作弊、杀毒（含 360）、系统关键进程、会话 0、自身进程链、以及一切映像位于 Windows 目录下的进程，本文件无法解除。",
  "protectShells": true,
  "skipSession0": true,
  "hostProtected": [
    "DeepSeek Harness",
    "dsh",
    "node",
    "deno",
    "bun",
    "python",
    "pythonw",
    "ffmpeg",
    "ffprobe",
    "NVIDIA Overlay",
    "NVIDIA Share",
    "nvsphelper64",
    "llama-server",
    "ollama",
    "ollama_llama_server",
    "koboldcpp",
    "lmstudio",
    "mstsc",
    "rdpclip",
    "putty",
    "ssh",
    "mintty",
    "ThrottleStop",
    "WinMemoryCleaner"
  ],
  "idleByDefault": [
    "Weixin",
    "WeChat",
    "WeChatAppEx",
    "QQ",
    "TIM",
    "DingTalk",
    "OneDrive",
    "OneDrive.Sync.Service",
    "Dropbox",
    "GoogleDriveFS",
    "BaiduNetdisk"
  ],
