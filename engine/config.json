  "selectRules": [
    {
      "name": "游戏平台保持运行",
      "match": "steam|steamwebhelper|GameOverlayUI|EpicGamesLauncher|EpicWebHelper|Battle.net|GalaxyClient|GOGGalaxy|EADesktop|EALocalHostSvc|EABackgroundService|UbisoftConnect|upc|UplayService|RiotClientServices|WeGame|wegame|XboxPcApp|GameBar",
      "action": "skip"
    },
    {
      "name": "聊天/同步/下载只降 QoS",
      "match": "Weixin|WeChat|WeChatAppEx|QQ|TIM|DingTalk|Lark|Feishu|OneDrive*|Dropbox|GoogleDriveFS|BaiduNetdisk*|Thunder*|qbittorrent|utorrent|BitComet|FreeDownloadManager|IDMan|aria2c",
      "action": "idle"
    },
    {
      "name": "播放器只降 QoS(不中断声音)",
      "match": "Spotify|foobar2000|vlc|mpv|PotPlayerMini64|QQMusic|cloudmusic",
      "action": "idle"
    },
    {
      "name": "虚拟机只降 QoS(不中断 guest)",
      "match": "vmware-vmx|vmware-authd|VBoxSVC|VirtualBoxVM|qemu-system*",
      "action": "idle"
    },
    {
      "name": "安卓模拟器只降 QoS（不冻结 guest，避免安卓系统卡死）",
      "match": "dnplayer|Ld9BoxHeadless|LdVBoxHeadless|AndrowsVm|ABoxHeadless|MuMuPlayer|NemuHeadless|Nox|NoxVMHandle|HD-Player|BlueStacks",
      "action": "idle"
    },
    {
      "name": "Adobe 后台与厂商控制台冻结",
      "match": "CCXProcess|CoreSync|AdobeIPCBroker|Adobe Desktop Service|AdobeUpdateService|AdobeARM|Logitech*|lghub*|iCUE*|Corsair*|Razer*|SteelSeriesGG|RadeonSoftware|amdow|AMDRSSrcExt|cncmd",
      "action": "suspend"
    },
    {
      "name": "常驻助手/挂机类后台冻结",
      "match": "WorkBuddy|Everything|TranslucentTB|cncmd",
      "action": "suspend",
      "minMemoryMB": 30
    },
    {
      "name": "其余一律不碰",
      "match": "*",
      "action": "skip"
    }
  ],
